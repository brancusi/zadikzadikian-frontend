# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
PROXY_KOA=false
PROXY_IP_HEADER=X-Forwarded-For
PROXY_MAX_IPS=1

# Required Strapi secrets. Leave blank in this example; `pnpm env:dev` generates .env.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# PostgreSQL. DATABASE_URL is required in production; local development can use fields.
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=zadikian_cms
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=cms_dev_only
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000
DATABASE_DEBUG=false

# Runtime behavior
CRON_ENABLED=false
TRANSFER_REMOTE_ENABLED=false
WEBHOOKS_POPULATE_RELATIONS=false
STRAPI_TELEMETRY_DISABLED=true
STRAPI_UPDATE_NOTIFICATIONS=false
FLAG_DOC_LINKS=true

# Upload storage. Keep `local` until the private R2 policy and credentials are approved.
UPLOAD_PROVIDER=local
MEDIA_CSP_ORIGIN=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
