{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/catalog/**",
              "components/core/**",
              "components/editorial/**",
              "components/typographic/**",
              "ui_kits/proposal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Libre Caslon Display|Libre Caslon Text))/i]",
        "message": "Font not provided by the design system. Available: Libre Caslon Display, Libre Caslon Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|onClick|disabled|href|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, onClick, disabled, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|text)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CVList'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|entries|key|ref|className|style|children)$/]",
        "message": "<CVList> doesn't accept that prop. Declared props: heading, entries."
      },
      {
        "selector": "JSXOpeningElement[name.name='Folio'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|center|right|key|ref|className|style|children)$/]",
        "message": "<Folio> doesn't accept that prop. Declared props: left, center, right."
      },
      {
        "selector": "JSXOpeningElement[name.name='PressItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|publication|author|year|key|ref|className|style|children)$/]",
        "message": "<PressItem> doesn't accept that prop. Declared props: quote, publication, author, year."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|attribution|source|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: quote, attribution, source."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|label|index|size|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: title, label, index, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:colossal|display|headline)$/]",
        "message": "<SectionHeading> size must be one of 'colossal' | 'display' | 'headline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpecList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|key|ref|className|style|children)$/]",
        "message": "<SpecList> doesn't accept that prop. Declared props: items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tombstone'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|year|medium|dimensions|edition|catalogNo|align|key|ref|className|style|children)$/]",
        "message": "<Tombstone> doesn't accept that prop. Declared props: title, year, medium, dimensions, edition, catalogNo, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tombstone'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Tombstone> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkFigure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|title|year|medium|dimensions|edition|catalogNo|bleed|key|ref|className|style|children)$/]",
        "message": "<WorkFigure> doesn't accept that prop. Declared props: src, alt, title, year, medium, dimensions, edition, catalogNo, bleed."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
