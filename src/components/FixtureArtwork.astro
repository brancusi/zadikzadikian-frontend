---
interface Props {
  variant: 'stack' | 'threshold' | 'field';
  description: string;
  ratio?: 'landscape' | 'portrait' | 'hero';
  compact?: boolean;
}

const {
  variant,
  description,
  ratio = 'landscape',
  compact = false,
} = Astro.props;
---
<figure class:list={['fixture', `fixture--${ratio}`, compact && 'fixture--compact']}>
  <div class:list={['fixture__image', `fixture__image--${variant}`]}>
    {variant === 'stack' && (
      <svg viewBox="0 0 1200 900" aria-hidden="true" focusable="false">
        <rect class="fixture-ink" width="1200" height="900" />
        <path class="fixture-line" d="M0 740H1200M190 740L390 500H995L1200 740" />
        <g class="fixture-gold">
          <rect x="264" y="566" width="232" height="102" />
          <rect x="502" y="566" width="232" height="102" />
          <rect x="740" y="566" width="232" height="102" />
          <rect x="342" y="458" width="232" height="102" />
          <rect x="580" y="458" width="232" height="102" />
          <rect x="461" y="350" width="232" height="102" />
        </g>
        <g class="fixture-cut">
          <rect x="286" y="588" width="188" height="58" />
          <rect x="524" y="588" width="188" height="58" />
          <rect x="762" y="588" width="188" height="58" />
          <rect x="364" y="480" width="188" height="58" />
          <rect x="602" y="480" width="188" height="58" />
          <rect x="483" y="372" width="188" height="58" />
        </g>
      </svg>
    )}
    {variant === 'threshold' && (
      <svg viewBox="0 0 1200 900" aria-hidden="true" focusable="false">
        <rect class="fixture-paper" width="1200" height="900" />
        <path class="fixture-shadow" d="M217 900L454 132H845L1081 900Z" />
        <g class="fixture-gold">
          <path d="M152 900L343 100H475L383 900Z" />
          <path d="M817 900L725 100H857L1048 900Z" />
          <path d="M343 100H857L822 249H378Z" />
        </g>
        <path class="fixture-sun" d="M547 491H653V597H547Z" />
        <path class="fixture-line-dark" d="M600 249V900M378 249H822" />
      </svg>
    )}
    {variant === 'field' && (
      <svg viewBox="0 0 1200 900" aria-hidden="true" focusable="false">
        <rect class="fixture-clay" width="1200" height="900" />
        <circle class="fixture-sun" cx="600" cy="390" r="190" />
        <path class="fixture-field" d="M0 647C180 589 354 678 541 621C755 555 969 598 1200 521V900H0Z" />
        <g class="fixture-rays">
          <path d="M600 82V184M600 596V707M292 390H394M806 390H908M382 172L454 244M746 536L818 608M818 172L746 244M454 536L382 608" />
        </g>
        <path class="fixture-line-light" d="M93 750H1107" />
      </svg>
    )}
  </div>
  <figcaption><strong>Preview fixture—not an artwork.</strong> {description}</figcaption>
</figure>
