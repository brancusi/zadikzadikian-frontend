---
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/work/', label: 'Work', active: pathname === '/' || pathname.startsWith('/work/') },
  { href: '/about/', label: 'About', active: pathname.startsWith('/about/') },
  { href: '/cv/', label: 'CV', active: pathname.startsWith('/cv/') },
  { href: '/contact/', label: 'Contact', active: pathname.startsWith('/contact/') },
];
---
<header class="site-header">
  <a class="wordmark" href="/" aria-label="Zadik Zadikian, preview home">
    <span>Zadik</span>
    <span>Zadikian</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
