---
import EditorialNote from '../components/EditorialNote.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    title: 'Solo exhibitions',
    entries: [
      ['Verified year', '[Approved exhibition title]', 'Institution · City, country · role'],
      ['Verified year', '[Approved exhibition title]', 'Institution · City, country · role'],
    ],
  },
  {
    title: 'Selected group exhibitions',
    entries: [
      ['Verified range', '[Approved exhibition title]', 'Institution · City, country · role'],
      ['Verified year', '[Approved exhibition title]', 'Institution · City, country · role'],
    ],
  },
  {
    title: 'Projects and awards',
    entries: [['Verified year', '[Approved project or award]', 'Context · location · verification source']],
  },
  {
    title: 'Collections and bibliography',
    entries: [['Verified year', '[Confirmed holding or publication]', 'Ownership or citation evidence']],
  },
];
---
<BaseLayout
  title="CV — Record preview"
  description="A web-first CV implementation for the noindex Zadik Zadikian preview. Model entries are not public factual claims."
>
  <div class="page-shell">
    <header class="cv-header">
      <div>
        <p class="eyebrow">Web-first record · one verified dataset</p>
        <h1>CV</h1>
      </div>
      <div class="cv-header__status">
        <p class="eyebrow">Revision status</p>
        <p>Editorial verification pending</p>
        <p>HTML remains primary; no unverified PDF is offered.</p>
      </div>
    </header>

    <section class="content-section cv-boundary" aria-labelledby="cv-boundary-heading">
      <h2 id="cv-boundary-heading" class="visually-hidden">CV preview boundary</h2>
      <EditorialNote title="Not factual entries">
        <p>Every bracketed row below is an interface model—not an exhibition, date, institution, award, holding, or biographical claim.</p>
        <p>The launch CV must resolve source conflicts, category anomalies, titles, locations, roles, and chronology through owner review.</p>
      </EditorialNote>
    </section>

    <section aria-labelledby="sample-cv-structure-heading">
      <h2 id="sample-cv-structure-heading" class="visually-hidden">Sample CV structure</h2>
      {sections.map((section) => {
        const id = `cv-${section.title.toLowerCase().replaceAll(' ', '-').replaceAll('&', 'and')}`;
        return (
          <section class="cv-section" aria-labelledby={id}>
            <div>
              <p class="eyebrow">Reviewed records only</p>
              <h2 id={id}>{section.title}</h2>
            </div>
            <dl class="cv-list">
              {section.entries.map(([date, title, context]) => (
                <div><dt>{date}</dt><dd><strong>{title}</strong><span>{context}</span></dd></div>
              ))}
            </dl>
          </section>
        );
      })}
    </section>

    <section class="content-section cv-principle" aria-labelledby="cv-policy-heading">
      <p class="eyebrow">Production principle</p>
      <div>
        <h2 id="cv-policy-heading">HTML first. PDF from the same data.</h2>
        <p>The future downloadable CV should be generated from the same reviewed records as this page, preventing silent divergence between formats.</p>
      </div>
    </section>
  </div>
</BaseLayout>
