---
import ArtworkImage from '../components/ArtworkImage.astro';
import ChapterRow from '../components/ChapterRow.astro';
import EditorialNote from '../components/EditorialNote.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const chapters = [
  {
    number: 'I',
    label: 'Proposed editorial lens',
    title: 'Ground',
    description: 'A reserved chapter for verified early work and the body as a measure of material, support, scale, and making.',
    href: '/work/#ground',
    linkLabel: 'View the chapter structure',
    mediaId: 'img-fixture-field-v1',
    placementId: 'placement-home-chapter-ground',
  },
  {
    number: 'II',
    label: 'Proposed editorial lens',
    title: 'Field',
    description: 'A framework for room, surface, atmosphere, and spatial conditions. Historical claims and installation records remain held for review.',
    href: '/work/solis/',
    linkLabel: 'View the sample treatment',
    mediaId: 'img-fixture-threshold-wide-v1',
    placementId: 'placement-home-chapter-field',
  },
  {
    number: 'III',
    label: 'Proposed editorial lens',
    title: 'Unit',
    description: 'A chapter pattern for repeated form, interval, portable structure, and exact object records without publishing unresolved dimensions or dates.',
    href: '/work/stacks/',
    linkLabel: 'View the sample treatment',
    mediaId: 'img-fixture-stack-v1',
    placementId: 'placement-home-chapter-unit',
  },
  {
    number: 'IV',
    label: 'Proposed editorial lens',
    title: 'Body',
    description: 'A rights-gated lane for figure, portrait, casting, and process. Person and depiction rights must clear before real records appear.',
    href: '/work/#body',
    linkLabel: 'View the held chapter',
    mediaId: 'img-fixture-threshold-wide-v1',
    placementId: 'placement-home-chapter-body',
  },
  {
    number: 'V',
    label: 'Proposed editorial lens',
    title: 'Open structure',
    description: 'A future-facing arrangement for color, touch, movement, and work in formation, translated here with project-created geometry only.',
    href: '/work/path-to-nine/',
    linkLabel: 'View the detail pattern',
    mediaId: 'img-fixture-field-v1',
    placementId: 'placement-home-chapter-open',
  },
];

const researchGates = [
  ['Archive record', 'Early spatial work · date and source review'],
  ['Institutional record', 'Exhibition chronology · role and ownership review'],
  ['Attribution record', 'Collaborative history · wording and citation review'],
  ['Current record', 'Programme status · rights and publication review'],
];

const sequenceRows = [
  ['Current', '[Verified title and dates]', 'Module hidden until approved'],
  ['Recent', '[Verified institution and role]', 'Source review required'],
  ['Archive', '[Verified exhibition record]', 'No acquisition implied'],
];
---
<BaseLayout
  title="Zadik Zadikian"
  description="A noindex implementation preview for a work-led Zadik Zadikian artist website. Original fixture graphics only; facts and media remain gated."
  bodyClass="home-page"
>
  <section class="opening-image" aria-label="Opening design study">
    <ArtworkImage
      mediaId="img-fixture-threshold-wide-v1"
      placementId="placement-home-hero-wide"
      sizes="100vw"
      loading="eager"
      priority
      fit="cover"
      class="artwork-image--opening"
      artDirection={{
        mediaId: 'img-fixture-threshold-portrait-v1',
        placementId: 'placement-home-hero-mobile',
        media: '(max-width: 42rem)',
        sizes: '100vw',
      }}
    />
  </section>

  <header class="home-thesis page-shell">
    <p class="eyebrow">Website direction · work before claims</p>
    <h1>Matter in formation</h1>
    <p class="home-thesis__lede">A retrospective site structure moving between body, room, repeated unit, and open field—without treating unverified editorial language as biography.</p>
    <p class="home-thesis__note">The design team’s work-led hierarchy is implemented here with approved sample routes and project-created fixtures. Public facts, artwork, credits, and current-project status remain outside this preview.</p>
  </header>

  <section class="page-shell content-section chapter-section" aria-labelledby="chapters-heading">
    <SectionHeading
      id="chapters-heading"
      label="The work in five chapters"
      title="A retrospective path"
      index="I — V"
    />
    <div class="chapter-list">
      {chapters.map((chapter) => <ChapterRow {...chapter} />)}
    </div>
  </section>

  <section class="page-shell content-section" aria-labelledby="historical-heading">
    <div class="section-rule-heading">
      <p class="eyebrow">Historical anchor · evidence before publication</p>
      <h2 id="historical-heading" class="visually-hidden">Historical research gates</h2>
    </div>
    <div class="evidence-band">
      {researchGates.map(([label, text]) => (
        <article>
          <p class="eyebrow">{label}</p>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="page-shell content-section" aria-labelledby="current-heading">
    <SectionHeading
      id="current-heading"
      label="Current work · publication held"
      title="The open structure"
      index="§"
    />
    <div class="feature-split">
      <ArtworkImage
        mediaId="img-fixture-stack-v1"
        placementId="placement-home-current"
        sizes="(max-width: 56rem) calc(100vw - 4rem), 60vw"
        loading="lazy"
        fit="cover"
      />
      <div class="feature-split__body">
        <p class="feature-split__lede">The supplied design reserves a decisive image-and-text module for current work.</p>
        <p>This implementation preserves its scale, caption discipline, and adjacent reading column while withholding project names, dates, venue roles, and interpretive claims until the existing editorial and rights gates clear.</p>
        <a class="text-link" href="/work/">View work architecture <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="page-shell content-section" aria-labelledby="sequence-heading">
    <div class="section-rule-heading section-rule-heading--split">
      <p class="eyebrow">Institutional sequence · model rows</p>
      <p class="eyebrow" aria-hidden="true">Verification pending</p>
      <h2 id="sequence-heading" class="visually-hidden">Institutional sequence model</h2>
    </div>
    <div class="sequence-list">
      {sequenceRows.map(([date, title, status]) => (
        <div class="sequence-row">
          <p>{date}</p>
          <p>{title}</p>
          <p class="eyebrow">{status}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="page-shell content-section latest-text" aria-labelledby="latest-heading">
    <blockquote>“Authorship before publication.”</blockquote>
    <div>
      <p class="eyebrow">Artist voice · approval required</p>
      <h2 id="latest-heading">A statement page with its status visible.</h2>
      <p>The delivered first-person draft is preserved privately but explicitly requires artist approval. The public preview implements the reading experience without attributing unapproved words.</p>
      <a class="text-link" href="/artist-statement/">Review the statement structure <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="page-shell content-section" aria-labelledby="boundary-heading">
    <h2 id="boundary-heading" class="visually-hidden">Preview content boundary</h2>
    <EditorialNote title="Review boundary">
      <p><strong>Every public visual remains a purpose-made fixture.</strong> It is not artwork by Zadik Zadikian and does not stand in for a final crop, credit, or alt description.</p>
      <p>Biographical dates, contact details, representation, current projects, portraits, real video, and launch authority remain withheld. The complete design-team payload is retained privately as immutable reference.</p>
    </EditorialNote>
  </section>
</BaseLayout>
