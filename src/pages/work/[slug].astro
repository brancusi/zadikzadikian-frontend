---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArtworkImage from '../../components/ArtworkImage.astro';
import EditorialNote from '../../components/EditorialNote.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import VideoPresentation from '../../components/VideoPresentation.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('series');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'series'> }
const { entry }: Props = Astro.props;
const { Content } = await render(entry);
const allSeries = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allSeries.findIndex((item) => item.id === entry.id);
const previous = currentIndex > 0 ? allSeries[currentIndex - 1] : undefined;
const next = currentIndex < allSeries.length - 1 ? allSeries[currentIndex + 1] : undefined;
const heroMediaId = {
  stack: 'img-fixture-stack-v1',
  threshold: 'img-fixture-threshold-wide-v1',
  field: 'img-fixture-field-v1',
}[entry.data.fixture];
const chapter = entry.id === 'solis' ? 'II · Field' : 'III · Unit';
const galleryStudies = [
  { key: 'threshold', title: 'Threshold study', mediaId: 'img-fixture-threshold-wide-v1', note: 'A wide composition tests scale, focal placement, and entry into object-level context.' },
  { key: 'stack', title: 'Repetition study', mediaId: 'img-fixture-stack-v1', note: 'A repeated-unit composition tests pacing and metadata beneath a dark image field.' },
  { key: 'field', title: 'Light study', mediaId: 'img-fixture-field-v1', note: 'A landscape composition tests responsive rhythm and a caption visible without interaction.' },
] as const;
const operations = ['Exact record', 'Visible caption', 'Rights state', 'Related route'];
---
<BaseLayout title={`${entry.data.title} — Sample series`} description={entry.data.description}>
  <article>
    <div class="page-shell breadcrumb"><a href="/work/">Work</a><span aria-hidden="true">—</span><span>{chapter}</span></div>

    <header class="page-shell detail-header">
      <div class="detail-header__meta">
        <p class="eyebrow">Sample series · facts held for verification</p>
        <p class="eyebrow">{chapter}</p>
      </div>
      <h1>{entry.data.title}</h1>
      <div class="detail-intro">
        <div>
          <p class="detail-intro__lede">{entry.data.intro}</p>
          <div class="prose"><Content /></div>
        </div>
        <div class="operation-list">
          <p class="eyebrow">Defining publication operations</p>
          <ul>{operations.map((operation) => <li>{operation}</li>)}</ul>
        </div>
      </div>
    </header>

    <section class="page-shell detail-feature" aria-labelledby="record-detail-heading">
      <ArtworkImage
        mediaId={heroMediaId}
        placementId={`placement-series-hero-${entry.id}`}
        sizes="(max-width: 56rem) calc(100vw - 4rem), 62vw"
        loading="eager"
        priority
        fit="cover"
        class="artwork-image--series-feature"
      />
      <div class="detail-feature__record">
        <p class="eyebrow">Work-detail pattern</p>
        <h2 id="record-detail-heading">A complete record before a claim.</h2>
        <p>{entry.data.description}</p>
        <dl class="spec-list">
          <div><dt>Dates</dt><dd>Pending verification</dd></div>
          <div><dt>Materials</dt><dd>Pending verification</dd></div>
          <div><dt>Dimensions</dt><dd>Pending verification</dd></div>
          <div><dt>Media</dt><dd>Owner master and public rights required</dd></div>
          <div><dt>Status</dt><dd>Sample treatment only</dd></div>
        </dl>
      </div>
    </section>

    <section class="page-shell content-section" aria-labelledby="gallery-heading">
      <SectionHeading
        id="gallery-heading"
        label="Selected views · editorial fixture sequence"
        title="Images with context"
        index="01 — 03"
      >
        <p>Captions, credits, intrinsic dimensions, and placement-specific alternatives remain attached at every size. The project-created studies below are not Zadikian artworks.</p>
      </SectionHeading>
      <nav class="gallery-jump" aria-label="Design-study gallery navigation">
        <p class="eyebrow">Jump to study</p>
        <ol>{galleryStudies.map((study, index) => <li><a href={`#${entry.id}-study-${study.key}`}>0{index + 1} {study.title}</a></li>)}</ol>
      </nav>
      <div class="editorial-gallery">
        {galleryStudies.map((study, index) => (
          <article id={`${entry.id}-study-${study.key}`} class:list={['gallery-study', index === 1 && 'gallery-study--offset']}>
            <ArtworkImage
              mediaId={study.mediaId}
              placementId={`placement-gallery-${entry.id}-${study.key}`}
              sizes="(max-width: 56rem) calc(100vw - 4rem), 72vw"
              loading="lazy"
              fit="cover"
            />
            <div class="gallery-study__record">
              <p class="eyebrow">Design study 0{index + 1}</p>
              <h3>{study.title}</h3>
              <p>{study.note}</p>
              <dl>
                <div><dt>Record</dt><dd>Fixture metadata complete</dd></div>
                <div><dt>Artwork facts</dt><dd>Not applicable—design study</dd></div>
                <div><dt>Rights</dt><dd>Project-created · CC0 1.0</dd></div>
              </dl>
              <a class="text-link" href="#gallery-heading">Back to gallery index <span aria-hidden="true">↑</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {entry.id === 'stacks' && (
      <section class="page-shell content-section" aria-labelledby="video-study-heading">
        <SectionHeading
          id="video-study-heading"
          label="Moving-image boundary"
          title="Intent before playback"
          index="§"
        >
          <p>The supplied design’s process intent is preserved without activating a player, provider, autoplay, or third-party request.</p>
        </SectionHeading>
        <VideoPresentation videoId="vid-fixture-process-study-v1" posterPlacementId="placement-video-process-poster" title="Process study · inert preview" />
      </section>
    )}

    <section class="page-shell content-section" aria-labelledby="sample-boundary-heading">
      <h2 id="sample-boundary-heading" class="visually-hidden">Sample page boundary</h2>
      <EditorialNote><p>{entry.data.description}</p></EditorialNote>
      <nav class="record-navigation" aria-label="Sample series navigation">
        <p>{previous ? <a href={`/work/${previous.id}/`}>← Previous: {previous.data.title}</a> : <a href="/work/">← Work index</a>}</p>
        <p>{next ? <a href={`/work/${next.id}/`}>Next: {next.data.title} →</a> : <a href="/work/">Work index →</a>}</p>
      </nav>
    </section>
  </article>
</BaseLayout>
