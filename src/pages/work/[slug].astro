---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArtworkImage from '../../components/ArtworkImage.astro';
import EditorialNote from '../../components/EditorialNote.astro';
import VideoPresentation from '../../components/VideoPresentation.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('series');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'series'>;
}

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
const allSeries = (await getCollection('series')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allSeries.findIndex((item) => item.id === entry.id);
const previous = currentIndex > 0 ? allSeries[currentIndex - 1] : undefined;
const next = currentIndex < allSeries.length - 1 ? allSeries[currentIndex + 1] : undefined;
const heroMediaId = {
  stack: 'img-fixture-stack-v1',
  threshold: 'img-fixture-threshold-wide-v1',
  field: 'img-fixture-field-v1',
}[entry.data.fixture];
const galleryStudies = [
  {
    key: 'threshold',
    title: 'Threshold study',
    mediaId: 'img-fixture-threshold-wide-v1',
    note: 'A wide composition tests scale, focal placement, and a quiet transition into object-level context.',
  },
  {
    key: 'stack',
    title: 'Repetition study',
    mediaId: 'img-fixture-stack-v1',
    note: 'A repeated-unit composition tests editorial pacing and metadata beneath a dark image field.',
  },
  {
    key: 'field',
    title: 'Light study',
    mediaId: 'img-fixture-field-v1',
    note: 'A landscape composition tests responsive rhythm and a caption that remains visible without interaction.',
  },
] as const;
---
<BaseLayout
  title={`${entry.data.title} — Sample series`}
  description={entry.data.description}
>
  <article>
    <header class="series-hero">
      <div class="series-hero__copy">
        <div>
          <p class="eyebrow">{entry.data.recordLabel}</p>
          <h1>{entry.data.title}</h1>
        </div>
        <p class="series-hero__intro">{entry.data.intro}</p>
      </div>
      <ArtworkImage
        mediaId={heroMediaId}
        placementId={`placement-series-hero-${entry.id}`}
        sizes="(max-width: 56rem) 100vw, 58vw"
        loading="eager"
        priority
        fit="cover"
        class="artwork-image--series-hero"
      />
    </header>

    <div class="series-details">
      <aside aria-labelledby="record-status-heading">
        <p id="record-status-heading" class="eyebrow">Record status</p>
        <ul class="record-list">
          <li>Dates · pending verification</li>
          <li>Materials · pending verification</li>
          <li>Dimensions · pending verification</li>
          <li>Images and credits · rights approval required</li>
        </ul>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <section class="page-shell content-section" aria-labelledby="gallery-heading">
      <div class="section-heading">
        <p class="eyebrow">Editorial gallery study</p>
        <h2 id="gallery-heading">Images with context, not a mystery grid.</h2>
        <p>Each original abstract study is a tiny project-created fixture—not a Zadikian artwork. Captions, credits, intrinsic dimensions, and placement-specific alternatives stay attached at every size.</p>
      </div>

      <nav class="gallery-jump" aria-label="Design-study gallery navigation">
        <p class="eyebrow">Jump to study</p>
        <ol>
          {galleryStudies.map((study, index) => (
            <li><a href={`#${entry.id}-study-${study.key}`}>0{index + 1} {study.title}</a></li>
          ))}
        </ol>
      </nav>

      <div class="editorial-gallery">
        {galleryStudies.map((study, index) => (
          <article id={`${entry.id}-study-${study.key}`} class:list={['gallery-study', index === 1 && 'gallery-study--offset']}>
            <ArtworkImage
              mediaId={study.mediaId}
              placementId={`placement-gallery-${entry.id}-${study.key}`}
              sizes="(max-width: 56rem) calc(100vw - 2rem), 72vw"
              loading="lazy"
              fit="cover"
            />
            <div class="gallery-study__record">
              <p class="eyebrow">Design study 0{index + 1}</p>
              <h3>{study.title}</h3>
              <p>{study.note}</p>
              <dl>
                <div><dt>Record</dt><dd>Fixture metadata complete</dd></div>
                <div><dt>Artwork facts</dt><dd>Not applicable—design study</dd></div>
                <div><dt>Rights</dt><dd>Project-created · CC0 1.0</dd></div>
              </dl>
              <a class="text-link" href="#gallery-heading">Back to gallery index ↑</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {entry.id === 'stacks' && (
      <section class="page-shell content-section" aria-labelledby="video-study-heading">
        <div class="section-heading">
          <p class="eyebrow">Moving-image foundation</p>
          <h2 id="video-study-heading">A quiet boundary before playback.</h2>
          <p>This treatment proves poster, caption, transcript, credit, and provider boundaries without activating Mux or reproducing the current site's staging videos.</p>
        </div>
        <VideoPresentation
          videoId="vid-fixture-process-study-v1"
          posterPlacementId="placement-video-process-poster"
          title="Process study · inert preview"
        />
      </section>
    )}

    <section class="page-shell content-section" aria-labelledby="sample-boundary-heading">
      <h2 id="sample-boundary-heading" class="visually-hidden">Sample page boundary</h2>
      <EditorialNote>
        <p>{entry.data.description}</p>
      </EditorialNote>
      <nav class="record-navigation" aria-label="Sample series navigation">
        <p>{previous ? <a href={`/work/${previous.id}/`}>← Previous: {previous.data.title}</a> : <a href="/work/">← Work index</a>}</p>
        <p>{next ? <a href={`/work/${next.id}/`}>Next: {next.data.title} →</a> : <a href="/work/">Work index →</a>}</p>
      </nav>
    </section>
  </article>
</BaseLayout>
